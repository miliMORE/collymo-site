---
import Shapes from './Shapes.astro';
import { EMAIL, GITHUB, LINKEDIN } from '../data';

const showError = Astro.url.searchParams.get('error') === '1';
const page = Astro.url.pathname || '/';
const cvMessage = 'Hi Collins,\n\nI came across your profile on collymo.com and would like to request a copy of your CV for [role / opportunity] at [organisation].\n\nA little about the opportunity:\n\nThanks,\n';
const field = 'mt-1.5 w-full rounded-xl border border-white/20 bg-ink-800 px-3 py-2.5 text-base text-white placeholder:text-slate-500';
const label = 'block text-sm font-semibold text-slate-100';
const projectTypes = ['Web app or platform', 'Data system or dashboard', 'Clinical data management support', 'Something else'];
const timelines = ['ASAP', '1-3 months', '3+ months', 'Not sure'];
---
<section id="contact" class="hero-bg relative overflow-hidden scroll-mt-20 text-white">
  <Shapes />
  <div id="contact-forms" class="wrap relative py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow !text-cy">Contact</p>
      <h2 class="mt-3 text-3xl font-bold sm:text-4xl">Let's <span class="grad-text">work together</span>.</h2>
      <p class="mt-4 text-slate-300">Clinical data management, research systems or a software project: I'd be glad to hear from you. I usually reply within 2 working days.</p>
    </div>
    {showError && <p role="alert" class="mx-auto mt-6 max-w-2xl rounded-xl border border-co/40 bg-co/10 px-4 py-3 text-sm text-white">Something went wrong. Please check the form and try again, or email me directly.</p>}
    <div class="relative mx-auto mt-8 max-w-2xl text-left">
      <div role="tablist" aria-label="Contact" id="contact-tabs" class="relative flex gap-1 overflow-x-auto border-b border-white/10">
        <a role="tab" href="#contact" id="contact-tab-message" data-ctab="message" aria-controls="cf-message" aria-selected="true" class="ctab whitespace-nowrap px-4 py-3 text-sm font-semibold text-slate-300 transition-colors hover:text-white aria-selected:text-white sm:px-5">Send a message</a>
        <a role="tab" href="#contact-work" id="contact-tab-work" data-ctab="work" aria-controls="contact-work" aria-selected="false" class="ctab whitespace-nowrap px-4 py-3 text-sm font-semibold text-slate-300 transition-colors hover:text-white aria-selected:text-white sm:px-5">Work with me</a>
        <a role="tab" href="#contact-cv" id="contact-tab-cv" data-ctab="cv" aria-controls="contact-cv" aria-selected="false" class="ctab whitespace-nowrap px-4 py-3 text-sm font-semibold text-slate-300 transition-colors hover:text-white aria-selected:text-white sm:px-5">Request my CV</a>
        <span id="contact-ind" class="pointer-events-none absolute bottom-[-1px] left-0 h-0.5 w-0 rounded-full" style="background-image:linear-gradient(90deg,#22d3ee,#93c5fd,#f472d0,#ff7a6b)" aria-hidden="true"></span>
      </div>

      <div id="contact-work" role="tabpanel" aria-labelledby="contact-tab-work" class="cf-panel scroll-mt-24">
        <form class="cf-form mt-6 space-y-4" method="post" action="/api/contact" data-kind="work" data-astro-reload>
          <input type="hidden" name="kind" value="work" />
          <input type="hidden" name="page" value={page} />
          <div class="cf-hp" aria-hidden="true"><label for="hp-work">Website</label><input id="hp-work" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
          <div><label class={label} for="work-name">Name</label><input class={field} id="work-name" name="name" type="text" required minlength="2" maxlength="100" autocomplete="name" /></div>
          <div><label class={label} for="work-email">Email</label><input class={field} id="work-email" name="email" type="email" required maxlength="254" autocomplete="email" /></div>
          <div><label class={label} for="work-org">Organisation <span class="font-normal text-slate-400">(optional)</span></label><input class={field} id="work-org" name="organisation" type="text" minlength="2" maxlength="200" autocomplete="organization" /></div>
          <div><label class={label} for="work-type">Project type</label>
            <select class={field} id="work-type" name="project_type" required>
              <option value="" disabled selected>Choose one</option>
              {projectTypes.map((item) => <option value={item}>{item}</option>)}
            </select>
          </div>
          <div><label class={label} for="work-when">Timeline</label>
            <select class={field} id="work-when" name="timeline" required>
              <option value="" disabled selected>Choose one</option>
              {timelines.map((item) => <option value={item}>{item}</option>)}
            </select>
          </div>
          <div><label class={label} for="work-budget">Budget <span class="font-normal text-slate-400">(optional)</span></label><input class={field} id="work-budget" name="budget" type="text" maxlength="200" /></div>
          <div><label class={label} for="work-message">Message</label><textarea class={`${field} min-h-36 resize-y`} id="work-message" name="message" required minlength="10" maxlength="5000" rows="5"></textarea></div>
          <p class="cf-status text-sm" role="status" aria-live="polite"></p>
          <button type="submit" class="btn-primary disabled:cursor-wait disabled:opacity-60">Send enquiry</button>
        </form>
      </div>

      <div id="contact-cv" role="tabpanel" aria-labelledby="contact-tab-cv" class="cf-panel scroll-mt-24">
        <form class="cf-form mt-6 space-y-4" method="post" action="/api/contact" data-kind="cv" data-astro-reload>
          <input type="hidden" name="kind" value="cv" />
          <input type="hidden" name="page" value={page} />
          <div class="cf-hp" aria-hidden="true"><label for="hp-cv">Website</label><input id="hp-cv" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
          <div><label class={label} for="cv-name">Name</label><input class={field} id="cv-name" name="name" type="text" required minlength="2" maxlength="100" autocomplete="name" /></div>
          <div><label class={label} for="cv-email">Email</label><input class={field} id="cv-email" name="email" type="email" required maxlength="254" autocomplete="email" /></div>
          <div><label class={label} for="cv-org">Organisation</label><input class={field} id="cv-org" name="organisation" type="text" required minlength="2" maxlength="200" autocomplete="organization" /></div>
          <div><label class={label} for="cv-role">Role or opportunity</label><input class={field} id="cv-role" name="role" type="text" required minlength="2" maxlength="200" placeholder="Clinical Data Manager, CRA, Developer" /></div>
          <div><label class={label} for="cv-message">Message</label><textarea class={`${field} min-h-52 resize-y`} id="cv-message" name="message" required minlength="10" maxlength="5000" rows="9">{cvMessage}</textarea></div>
          <p class="cf-status text-sm" role="status" aria-live="polite"></p>
          <button type="submit" class="btn-primary disabled:cursor-wait disabled:opacity-60">Request CV</button>
        </form>
      </div>

      <div id="cf-message" role="tabpanel" aria-labelledby="contact-tab-message" class="cf-panel scroll-mt-24">
        <form class="cf-form mt-6 space-y-4" method="post" action="/api/contact" data-kind="message" data-astro-reload>
          <input type="hidden" name="kind" value="message" />
          <input type="hidden" name="page" value={page} />
          <div class="cf-hp" aria-hidden="true"><label for="hp-message">Website</label><input id="hp-message" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
          <div><label class={label} for="msg-name">Name</label><input class={field} id="msg-name" name="name" type="text" required minlength="2" maxlength="100" autocomplete="name" /></div>
          <div><label class={label} for="msg-email">Email</label><input class={field} id="msg-email" name="email" type="email" required maxlength="254" autocomplete="email" /></div>
          <div><label class={label} for="msg-message">Message</label><textarea class={`${field} min-h-36 resize-y`} id="msg-message" name="message" required minlength="10" maxlength="5000" rows="6"></textarea></div>
          <p class="cf-status text-sm" role="status" aria-live="polite"></p>
          <button type="submit" class="btn-primary disabled:cursor-wait disabled:opacity-60">Send message</button>
        </form>
      </div>

      <p class="mt-8 flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm text-slate-300">
        <a class="hover:text-white" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <a class="hover:text-white" href={GITHUB} rel="me">GitHub</a>
        {LINKEDIN && <a class="hover:text-white" href={LINKEDIN} rel="me">LinkedIn</a>}
      </p>
    </div>
  </div>
</section>
