---
// Browser-framed screenshot. AVIF + WebP, responsive, lazy by default.
interface Props { name: string; alt: string; url: string; eager?: boolean; sizes?: string }
const { name, alt, url, eager = false, sizes = '(min-width:1024px) 560px, 92vw' } = Astro.props;
const set = (ext: string) => `/img/shots/${name}-640.${ext} 640w, /img/shots/${name}-1280.${ext} 1280w`;
---
<figure class="overflow-hidden rounded-xl border border-white/10 bg-ink-800 shadow-[0_20px_50px_-20px_rgba(34,211,238,.25)]">
  <div class="flex items-center gap-1.5 border-b border-white/10 bg-white/[0.04] px-3 py-2" aria-hidden="true">
    <span class="h-2.5 w-2.5 rounded-full bg-co/80"></span><span class="h-2.5 w-2.5 rounded-full bg-[#fbbf24]/80"></span><span class="h-2.5 w-2.5 rounded-full bg-cy/80"></span>
    <span class="ml-2 truncate rounded bg-white/5 px-2 py-0.5 text-[11px] text-slate-300">{url}</span>
  </div>
  <picture>
    <source type="image/avif" srcset={set('avif')} sizes={sizes} />
    <source type="image/webp" srcset={set('webp')} sizes={sizes} />
    <img src={`/img/shots/${name}-640.webp`} width="1280" height="720" alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" class="block h-auto w-full" />
  </picture>
</figure>
