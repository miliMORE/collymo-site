---
import '../styles.css';
import { ClientRouter } from 'astro:transitions';
import { EMAIL, GITHUB, LINKEDIN } from '../data';
interface Props { title?: string; description?: string; noindex?: boolean; og?: string; ogAlt?: string }
const { title, description = 'Collins Milimo (Collo) is a software developer and clinical data manager in Kenya. He builds software with Internet Congress Limited, including VERDICT, an ethics review platform, and ShelfCast.', noindex = false, og = 'og-home', ogAlt = 'Collins Milimo, Software Developer & Data Manager' } = Astro.props;
const ogUrl = `https://collymo.com/img/og/${og}.png`;
const full = title ? `${title} | Collins Milimo` : 'Collins Milimo (Collo) | Software Developer & Data Manager';
const canonical = new URL(Astro.url.pathname, 'https://collymo.com').href;
const ld = { '@context': 'https://schema.org', '@type': 'Person', '@id': 'https://collymo.com/#person', name: 'Collins Milimo', alternateName: 'Collo', givenName: 'Collins', familyName: 'Milimo', nationality: 'Kenyan', knowsAbout: ['Clinical data management', 'Good Clinical Practice', 'Research ethics', 'Software development', 'TypeScript', 'Python'], jobTitle: 'Software Developer & Data Manager', url: 'https://collymo.com', image: 'https://collymo.com/img/og/og-home.png', email: `mailto:${EMAIL}`, sameAs: [LINKEDIN, GITHUB], alumniOf: 'University of Nairobi', worksFor: [{ '@type': 'Organization', name: 'Victoria Biomedical Research Institute (VIBRI)' }, { '@type': 'Organization', name: 'Internet Congress Limited', url: 'https://internetcongress.org' }] };
const nav = [['Work', '/#projects'], ['Clinical research', '/clinical-research'], ['About', '/#about'], ['Contact', '/#contact']];
---
<!doctype html>
<html lang="en" class="no-js">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="profile" /><meta property="og:site_name" content="Collins Milimo" /><meta property="og:title" content={full} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogUrl} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={ogAlt} />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={full} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={ogUrl} /><meta name="twitter:image:alt" content={ogAlt} />
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
  <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  <meta name="author" content="Collins Milimo" />
  <meta name="theme-color" content="#151b24" />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <script is:inline>
    (function () { var h = document.documentElement; h.classList.remove('no-js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) { h.classList.add('motion');
        // Failsafe: if GSAP hasn't started within 2.5s, show everything.
        setTimeout(function () { if (!h.dataset.motionReady) h.classList.remove('motion'); }, 2500); } })();
    document.addEventListener('astro:after-swap', function () { if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion'); });
  </script>
  <ClientRouter fallback="swap" />
</head>
<body class="min-h-screen flex flex-col bg-ink text-slate-300 antialiased">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:text-ink focus:p-3">Skip to content</a>
  <header class="fixed inset-x-0 top-0 z-40 bg-ink/70 backdrop-blur border-b border-white/10" transition:persist>
    <div class="wrap flex h-16 items-center justify-between text-white">
      <a href="/" class="flex items-center gap-2.5 font-bold tracking-tight text-lg"><picture><source type="image/webp" srcset="/img/avatar-128.webp" /><img src="/img/avatar-64.png" width="30" height="30" alt="" class="h-[30px] w-[30px] rounded-full" /></picture><span>collymo<span class="grad-text">.</span></span></a>
      <nav aria-label="Main" class="hidden md:flex items-center gap-7 text-sm">
        {nav.map(([l, h]) => <a href={h} class="hover:text-cy">{l}</a>)}
        <a href="/#contact-cv" class="rounded-full border border-white/25 px-4 py-1.5 hover:bg-white/10">Request my CV</a>
      </nav>
      <button type="button" id="menu-btn" class="md:hidden inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/20 hover:bg-white/10" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path class="m-open" d="M4 7h16M4 12h16M4 17h16"/><path class="m-close hidden" d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <div id="mobile-menu" class="md:hidden border-t border-white/10 bg-ink/95 backdrop-blur" hidden>
      <nav aria-label="Mobile" class="wrap flex flex-col py-3 text-base text-white">
        {nav.map(([l, h]) => <a href={h} class="rounded-lg px-3 py-3 hover:bg-white/10" data-menu-link>{l}</a>)}
        <a href="/#contact-cv" class="btn-primary mt-2 justify-center" data-menu-link>Request my CV</a>
        <div class="mt-3 flex gap-5 px-3 pb-2 text-sm text-slate-300"><a href={GITHUB} rel="me">GitHub</a>{LINKEDIN && <a href={LINKEDIN} rel="me">LinkedIn</a>}</div>
      </nav>
    </div>
  </header>
  <main id="main" class="flex-1 pt-16"><slot /></main>
  <footer class="border-t border-white/10 bg-ink text-slate-400 text-sm">
    <div class="wrap py-10 flex flex-col sm:flex-row gap-4 justify-between">
      <p>© {new Date().getFullYear()} Collins Milimo</p>
      <p class="flex flex-wrap gap-x-5 gap-y-2"><a class="hover:text-white" href={`mailto:${EMAIL}`}>Email</a><a class="hover:text-white" href={GITHUB} rel="me">GitHub</a>{LINKEDIN && <a class="hover:text-white" href={LINKEDIN} rel="me">LinkedIn</a>}<a class="hover:text-white" href="https://internetcongress.org" target="_blank" rel="noopener">Internet Congress</a><a class="hover:text-white" href="/clinical-research">Clinical research</a></p>
    </div>
  </footer>
  <script>
    import '../scripts/motion';
    function initMenu() {
      const btn = document.getElementById('menu-btn'); const menu = document.getElementById('mobile-menu');
      if (!btn || !menu || btn.dataset.bound) return; btn.dataset.bound = '1';
      const set = (open: boolean) => { menu.hidden = !open; btn.setAttribute('aria-expanded', String(open)); btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        btn.querySelector('.m-open')!.classList.toggle('hidden', open); btn.querySelector('.m-close')!.classList.toggle('hidden', !open);
        if (open) (menu.querySelector('a') as HTMLElement)?.focus(); };
      btn.addEventListener('click', () => set(menu.hidden));
      menu.querySelectorAll('[data-menu-link]').forEach(a => a.addEventListener('click', () => set(false)));
      document.addEventListener('keydown', e => { if (e.key === 'Escape' && !menu.hidden) { set(false); btn.focus(); } });
      document.addEventListener('astro:after-swap', () => set(false));
      matchMedia('(min-width: 768px)').addEventListener('change', e => { if (e.matches) set(false); });
    }
    document.addEventListener('astro:page-load', initMenu);
    // Pause decorative background animation while off-screen.
    let bgIO: IntersectionObserver | null = null;
    function initBgPause() {
      bgIO?.disconnect();
      const els = document.querySelectorAll<HTMLElement>('[data-bg-anim]');
      if (!('IntersectionObserver' in window)) return;
      bgIO = new IntersectionObserver(es => es.forEach(e => e.target.classList.toggle('bg-paused', !e.isIntersecting)), { rootMargin: '100px' });
      els.forEach(el => bgIO!.observe(el));
    }
    document.addEventListener('astro:page-load', initBgPause);
  </script>
  <script is:inline>
    (function () {
      var IDS = { message: 'cf-message', work: 'contact-work', cv: 'contact-cv' };
      var HASH = { message: '#contact', work: '#contact-work', cv: '#contact-cv' };
      function root() { return document.getElementById('contact-forms'); }
      function tabEls() { var box = root(); return box ? [].slice.call(box.querySelectorAll('[data-ctab]')) : []; }
      function kindFromHash() {
        if (location.hash === '#contact-cv') return 'cv';
        if (location.hash === '#contact-work') return 'work';
        if (location.hash === '#contact' || location.hash === '#contact-message') return 'message';
        return null;
      }
      function place(animate) {
        var list = document.getElementById('contact-tabs');
        var ind = document.getElementById('contact-ind');
        if (!list || !ind) return;
        var current = list.querySelector('[aria-selected="true"]');
        if (!current) return;
        var x = current.offsetLeft, w = current.offsetWidth;
        var g = window.__gsap;
        if (animate && g && !matchMedia('(prefers-reduced-motion: reduce)').matches) g.to(ind, { x: x, width: w, duration: 0.45, ease: 'power3.out' });
        else { ind.style.transform = 'translateX(' + x + 'px)'; ind.style.width = w + 'px'; }
      }
      function show(kind) {
        var box = root(); if (!box) return;
        box.classList.add('is-ready');
        Object.keys(IDS).forEach(function (key) {
          var panel = document.getElementById(IDS[key]);
          if (panel) panel.classList.toggle('is-on', key === kind);
        });
        tabEls().forEach(function (tab) {
          var on = tab.getAttribute('data-ctab') === kind;
          tab.setAttribute('aria-selected', on ? 'true' : 'false');
          tab.tabIndex = on ? 0 : -1;
        });
        place(true);
      }
      function fillCv(form) {
        var msg = form.querySelector('[name="message"]');
        if (!msg || msg.getAttribute('data-dirty') === '1') return;
        var roleEl = form.querySelector('[name="role"]');
        var orgEl = form.querySelector('[name="organisation"]');
        var role = roleEl && roleEl.value.trim() ? roleEl.value.trim() : '[role / opportunity]';
        var org = orgEl && orgEl.value.trim() ? orgEl.value.trim() : '[organisation]';
        msg.value = msg.defaultValue.split('[role / opportunity]').join(role).split('[organisation]').join(org);
      }
      document.addEventListener('click', function (e) {
        var tab = e.target.closest && e.target.closest('[data-ctab]');
        var box = root();
        if (!tab || !box || !box.contains(tab)) return;
        e.preventDefault();
        e.stopPropagation();
        var kind = tab.getAttribute('data-ctab');
        show(kind);
        if (location.hash !== HASH[kind]) history.replaceState(null, '', HASH[kind]);
      }, true);
      document.addEventListener('keydown', function (e) {
        var tab = e.target.closest && e.target.closest('[data-ctab]');
        var box = root();
        if (!tab || !box || !box.contains(tab)) return;
        var list = tabEls();
        var i = list.indexOf(tab);
        var next = -1;
        if (e.key === 'ArrowRight') next = (i + 1) % list.length;
        else if (e.key === 'ArrowLeft') next = (i - 1 + list.length) % list.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = list.length - 1;
        if (next < 0) return;
        e.preventDefault();
        var kind = list[next].getAttribute('data-ctab');
        show(kind);
        list[next].focus();
        if (location.hash !== HASH[kind]) history.replaceState(null, '', HASH[kind]);
      }, true);
      document.addEventListener('input', function (e) {
        var el = e.target;
        if (!el || !el.form || !el.form.classList.contains('cf-form') || el.form.getAttribute('data-kind') !== 'cv') return;
        if (el.name === 'message' && e.isTrusted) el.setAttribute('data-dirty', '1');
        if (el.name === 'role' || el.name === 'organisation') fillCv(el.form);
      });
      document.addEventListener('submit', function (e) {
        var form = e.target;
        if (!form || !form.classList || !form.classList.contains('cf-form') || !window.fetch || !window.FormData) return;
        e.preventDefault();
        e.stopPropagation();
        var btn = form.querySelector('[type="submit"]');
        var status = form.querySelector('.cf-status');
        var label = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Sending…';
        if (status) { status.textContent = ''; status.className = 'cf-status mt-1 text-sm'; }
        fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' }, credentials: 'same-origin' })
          .then(function (res) { return res.json().then(function (body) { return { ok: res.ok && body.ok, error: body.error }; }, function () { return { ok: false, error: 'Something went wrong. Please email instead.' }; }); })
          .then(function (result) {
            if (result.ok) {
              form.reset();
              var msg = form.querySelector('[name="message"]');
              if (msg) msg.removeAttribute('data-dirty');
              if (status) status.textContent = 'Thanks, your message is on its way. I usually reply within 2 working days.';
              if (status) status.classList.add('text-cy');
            } else if (status) {
              status.textContent = result.error || 'Something went wrong. Please email instead.';
              status.classList.add('text-co');
            }
          })
          .catch(function () {
            if (status) { status.textContent = 'Something went wrong. Please email instead.'; status.classList.add('text-co'); }
          })
          .then(function () { btn.disabled = false; btn.textContent = label; });
      }, true);
      function boot() {
        if (!root()) return;
        show(kindFromHash() || 'message');
      }
      document.addEventListener('astro:page-load', boot);
      window.addEventListener('hashchange', boot);
      window.addEventListener('resize', function () { place(false); });
      boot();
    })();
  </script>
</body>
</html>
