---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import Shapes from '../components/Shapes.astro';
import WhatIDo from '../components/WhatIDo.astro';
import ContactForms from '../components/ContactForms.astro';
import { PROJECTS, ROLES } from '../data';
const tabs = [['all','All'],['saas','SaaS'],['client','Client work']];
const skills = [
  ['Clinical data management', ['Quality control','Query resolution','CRF & source-document design','Data cleaning & standardisation','Database backups','Visit schedules']],
  ['Regulatory & ethics', ['Good Clinical Practice','Regulatory submissions','Ethics committee liaison','Audit preparation','Records management','Document control']],
  ['Analysis', ['STATA','SQL','Statistics','Advanced Excel']],
  ['Software', ['TypeScript','Next.js','Astro','Prisma','PostgreSQL','Python','Django','Google Apps Script','Docker','Railway']],
];
const edu = [
  ['BSc Mathematics','University of Nairobi','Sep 2021'],
  ['Mobile Software Development & Entrepreneurship Program (MIT)','eMobilis Mobile Technology Institute','May 2017'],
];
const certs = [
  ['Good Clinical Practice (GCP)','CITI Program','Jul 2021'],
  ['Biomedical Responsible Conduct of Research','CITI Program','Feb 2025'],
  ['Modern Records Management (short course)','University of Nairobi, Dept. of Library & Information Science','Oct 2022'],
];
---
<Base>
  <section class="hero-bg relative overflow-hidden text-white" data-bg-anim>
    <div class="grid-bg absolute inset-0 opacity-60" aria-hidden="true"></div>
    <Shapes variant="hero" />
    <div class="wrap relative grid items-center gap-10 pt-16 sm:pt-20 lg:grid-cols-[1.35fr_1fr]" data-hero>
      <div class="pb-12 lg:pb-24">
        <p class="eyebrow !text-cy reveal">Collins (Collo) Milimo</p>
        <h1 class="mt-4 text-4xl font-bold leading-[1.05] tracking-tight sm:text-6xl" data-split>
          {['Software','Developer'].map(w => <><span class="w"><span>{w}</span></span>{' '}</>)}<span class="w"><span class="grad-text">&amp;</span></span>{' '}<span class="w"><span>Data</span></span>{' '}<span class="w"><span>Manager</span></span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-slate-200 reveal">Clinical data coordinator who builds the software research teams run on. Data Coordinator at Victoria Biomedical Research Institute (VIBRI), Kenya.</p>
        <div class="mt-9 flex flex-wrap gap-3 reveal"><a href="#projects" class="btn-primary" data-magnetic>View projects</a><a href="/clinical-research" class="btn-line" data-magnetic>Clinical research journey</a><a href="/#contact-cv" class="btn-line" data-magnetic>Request my CV</a></div>
      </div>
      <div class="relative mx-auto w-[260px] sm:w-[300px] lg:w-[330px] self-end lg:justify-self-center">
        <div class="absolute inset-x-6 top-10 bottom-0" aria-hidden="true" data-blob><div class="blob"></div></div>
        <picture>
          <source type="image/avif" srcset="/img/collo-cutout-330.avif 330w, /img/collo-cutout-660.avif 660w" sizes="(min-width:1024px) 330px, (min-width:640px) 300px, 260px" />
          <source type="image/webp" srcset="/img/collo-cutout-330.webp 330w, /img/collo-cutout-660.webp 660w" sizes="(min-width:1024px) 330px, (min-width:640px) 300px, 260px" />
          <img src="/img/collo-cutout-330.png" width="330" height="329" decoding="async" fetchpriority="high" alt="Portrait of Collins Milimo in a white shirt and grey tie" class="relative block h-auto w-full drop-shadow-[0_20px_40px_rgba(21,27,36,.55)]" data-parallax transition:name="portrait" />
        </picture>
      </div>
    </div>
  </section>

  <section id="about" data-section class="wrap scroll-mt-20 py-20 grid gap-10 lg:grid-cols-[1fr_2fr]">
    <div class="reveal"><p class="eyebrow">About</p><h2 class="h2 mt-2">Data, regulation <span class="grad-text">and code</span>.</h2></div>
    <div class="space-y-4 text-lg leading-relaxed reveal">
      <p>I'm Collins (Collo) Milimo, a clinical data specialist and software developer in Kenya. Since 2021 I've managed data and regulatory work on clinical trials, first at Butere Clinical Research Centre and now as Data Coordinator at Victoria Biomedical Research Institute (VIBRI).</p>
      <p>My work covers data quality control, query resolution, statistical reporting, source-document design and ethics committee submissions, all under Good Clinical Practice. I hold a BSc in Mathematics from the University of Nairobi and trained in mobile software development at eMobilis.</p>
      <p>I also build software with <a href="https://internetcongress.org" target="_blank" rel="noopener" class="font-semibold text-cy hover:underline">Internet Congress Limited</a>, a tech company in Kisumu, Kenya. That work includes VERDICT, a platform for research ethics and scientific review committees, and ShelfCast, a private audiobook app.</p>
    </div>
  </section>

  <WhatIDo />

  <section id="projects" class="relative overflow-hidden scroll-mt-20 section-glow border-y border-white/5"><Shapes /><div class="wrap relative py-20">
    <p class="eyebrow reveal">Selected work</p>
    <h2 class="h2 mt-2 reveal">Selected <span class="grad-text">projects</span></h2>
    <p class="mt-4 max-w-2xl text-lg reveal">I build software with <a href="https://internetcongress.org" target="_blank" rel="noopener" class="font-semibold text-cy hover:underline">Internet Congress Limited</a>, a tech company in Kisumu, Kenya.</p>
    <div role="tablist" aria-label="Filter projects" class="mt-8 flex flex-wrap gap-2 reveal">
      {tabs.map(([k, l], i) => <button role="tab" data-filter={k} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="ptab rounded-full border border-white/20 text-slate-200 px-4 py-2 text-sm font-semibold transition-colors aria-selected:border-cy aria-selected:bg-cy aria-selected:text-ink">{l}</button>)}
    </div>
    <div id="project-grid" class="mt-8 grid gap-6 md:grid-cols-2" aria-live="polite">
      {PROJECTS.map(p => (
        <article data-tags={p.tags.join(' ')} class="pcard card group relative flex flex-col overflow-hidden transition-[opacity,box-shadow] duration-300 hover:shadow-[0_20px_50px_-18px_rgba(34,211,238,.35)] will-change-transform" data-tilt>
          <span class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100" style="background: radial-gradient(320px circle at var(--mx,50%) var(--my,50%), rgba(34,211,238,.12), transparent 60%)" aria-hidden="true"></span>
          <div class="relative flex items-center justify-between gap-3"><span class="chip !bg-cy/10 !text-cy">{p.tag}</span>{!p.href && !p.site && <span class="text-xs text-slate-300">Client name withheld</span>}</div>
          {p.shot ? <div class="relative mt-4"><Shot name={p.shot.name} url={p.shot.url} alt={p.shot.alt} sizes="(min-width:768px) 520px, 90vw" /></div>
            : <div class="relative mt-4 grid aspect-[16/9] place-items-center rounded-xl border border-dashed border-white/15 bg-gradient-to-br from-ink-700/60 to-ink-800 text-sm text-slate-300" aria-hidden="true">Client work: screenshots withheld</div>}
          <h3 class="relative mt-5 text-xl font-semibold text-white" transition:name={p.href ? `title-${p.slug}` : undefined}>{p.name}</h3>
          <p class="relative mt-2 flex-1">{p.blurb}</p>
          {p.outcome && <p class="relative mt-3 text-sm font-medium text-cy">✓ {p.outcome}</p>}
          <ul class="mt-4 flex flex-wrap gap-2">{p.stack.map(s => <li class="chip">{s}</li>)}</ul>
          {(p.href || p.site) && <div class="relative mt-5 flex flex-wrap items-center gap-x-4 gap-y-1">
            {p.href && <a href={p.href} class="font-semibold text-cy hover:underline">Read the case study →</a>}
            {p.site && <a href={p.site.href} target="_blank" rel="noopener" class="text-sm font-semibold text-cy hover:underline">Visit site <span class="font-normal text-slate-300">· {p.site.label}</span></a>}
          </div>}
        </article>
      ))}
    </div>
  </div></section>
  <script>
    function initTabs() {
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('.ptab')];
      const cards = [...document.querySelectorAll<HTMLElement>('.pcard')];
      if (!tabs.length) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const select = (t: HTMLButtonElement) => {
        const f = t.dataset.filter!;
        tabs.forEach(x => { const on = x === t; x.setAttribute('aria-selected', String(on)); x.tabIndex = on ? 0 : -1; });
        cards.forEach(c => {
          const show = f === 'all' || c.dataset.tags!.split(' ').includes(f);
          if (reduce) { c.hidden = !show; return; }
          if (show) { c.hidden = false; c.style.opacity = '0'; c.style.transform = 'translateY(12px)'; requestAnimationFrame(() => { c.style.opacity = ''; c.style.transform = ''; }); }
          else c.hidden = true;
        });
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(t));
        t.addEventListener('keydown', e => { const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0; if (d) { const n = tabs[(i + d + tabs.length) % tabs.length]; select(n); n.focus(); } });
      });
    }
    document.addEventListener('astro:page-load', initTabs);
  </script>

  <section class="wrap py-20">
    <div class="flex flex-wrap items-end justify-between gap-4"><div><p class="eyebrow reveal">Experience</p><h2 class="h2 mt-2 reveal">Where I've <span class="grad-text">worked</span></h2></div><a href="/clinical-research" class="font-semibold text-cy hover:underline reveal">Full clinical research journey →</a></div>
    <ol class="mt-10 grid gap-6 md:grid-cols-3">
      {ROLES.map(r => <li class="card reveal"><p class="text-sm font-semibold text-cy">{r.when}</p><h3 class="mt-2 text-lg font-semibold text-white">{r.title}</h3><p class="text-sm text-slate-300">{r.org}</p><p class="mt-3 text-sm">{r.points[0]}.</p></li>)}
    </ol>
  </section>

  <section class="section-glow border-y border-white/5"><div class="wrap py-20">
    <p class="eyebrow reveal">Skills</p><h2 class="h2 mt-2 reveal">What I <span class="grad-text">bring</span></h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">{skills.map(([g, list]) => <div class="card reveal"><h3 class="font-semibold text-white">{g}</h3><ul class="mt-4 flex flex-wrap gap-2">{(list as string[]).map(s => <li class="chip">{s}</li>)}</ul></div>)}</div>
  </div></section>

  <section class="wrap py-20 grid gap-10 lg:grid-cols-2">
    <div><p class="eyebrow reveal">Education</p><ul class="mt-6 space-y-4">{edu.map(([t, o, d]) => <li class="card reveal"><p class="font-semibold text-white">{t}</p><p class="text-sm text-slate-300">{o} · {d}</p></li>)}</ul></div>
    <div><p class="eyebrow reveal">Certifications &amp; courses</p>
      <!-- TODO: add verification links (CITI completion-report "verify" URLs need Collo's certificate IDs; UoN short course has no public verifier). --><ul class="mt-6 space-y-4">{certs.map(([t, o, d]) => <li class="card reveal"><p class="font-semibold text-white">{t}</p><p class="text-sm text-slate-300">{o} · {d}</p></li>)}</ul></div>
  </section>

  <ContactForms />
</Base>
