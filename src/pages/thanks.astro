---
import Base from '../layouts/Base.astro';
---
<Base title="Message sent" noindex description="Your message to Collins Milimo is on its way.">
  <section class="wrap py-32 text-center">
    <p class="eyebrow">Contact</p>
    <h1 class="h2 mt-2">Thanks, your message is <span class="grad-text">on its way</span>.</h1>
    <p class="mx-auto mt-4 max-w-xl text-lg">I usually reply within 2 working days.</p>
    <a href="/" class="btn-dark mt-8">Back home</a>
  </section>
</Base>
