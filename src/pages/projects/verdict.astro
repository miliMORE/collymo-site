---
import Base from '../../layouts/Base.astro';
import Shot from '../../components/Shot.astro';
import Shapes from '../../components/Shapes.astro';
---
<Base og="og-verdict" ogAlt="VERDICT case study by Collins Milimo" title="VERDICT case study" description="VERDICT case study: an ethics and scientific review committee platform designed and built by Collins Milimo (Collo), from submission to signed approval letter.">
  <section class="hero-bg relative overflow-hidden text-white"><Shapes variant="hero" /><div class="wrap relative py-20">
    <a href="/#projects" class="text-sm text-slate-400 hover:text-white">← All projects</a>
    <p class="eyebrow !text-cy mt-6">Case study · Research &amp; ethics</p>
    <h1 class="mt-3 text-4xl font-bold sm:text-6xl" transition:name="title-verdict"><span class="grad-text">VERDICT</span></h1>
    <p class="mt-5 max-w-2xl text-lg text-slate-300">A platform that takes ethics and scientific review committees from submission to signed approval letter, with every step recorded.</p>
    <a href="https://verdictethics.com" class="btn-primary mt-8">Visit verdictethics.com</a>
  </div></section>
  <section class="wrap py-16 grid gap-10 lg:grid-cols-3">
    <div class="lg:col-span-2 space-y-10">
      <div class="reveal"><h2 class="h2 !text-2xl">The problem</h2><p class="mt-3">Research ethics committees juggle submissions, reviewer opinions, meetings, queries, letters and fees across email and spreadsheets. Working on the data and regulatory side of clinical trials, I saw how hard it is for applicants, reviewers and secretariats to know where a study stands.</p></div>
      <div class="reveal"><h2 class="h2 !text-2xl">What I built</h2>
        <ul class="mt-4 space-y-3 list-disc pl-5">
          <li><strong>Applicants</strong> register, add institution and site details, submit study packages, see fee notices when billing is on, and download the signed approval letter once it is issued.</li>
          <li><strong>Reviewers</strong> submit opinions (Satisfactory, Requires clarification, Not satisfactory) with comment rules from a catalog. Each opinion stays hidden from other reviewers until they submit their own, and reviews lock once a decision or letter is issued.</li>
          <li><strong>The secretariat</strong> works from a query-letter workspace showing "X of Y responded", alongside package documents and applicant management.</li>
          <li>Meetings, messages, notifications, invoices, a metrics dashboard, resources and help, plus password reset and email verification.</li>
          <li>Committee name, letterhead and reference prefixes are configurable, so the platform works for any institution. Each committee runs on its own deployment and database.</li>
        </ul>
      </div>
      <div class="reveal"><h2 class="h2 !text-2xl">The marketing site</h2><p class="mt-3">I also built verdictethics.com, the product's marketing site, with Astro and Tailwind: product, security and pricing pages, a demo-request form with spam protection, and a server-side www-to-apex redirect.</p></div>
      <div class="reveal"><h2 class="h2 !text-2xl">Outcome</h2><p class="mt-3">VERDICT is in use by the VIBRI Ethics and Scientific Review Committee.</p></div>
      <div class="reveal"><h2 class="h2 !text-2xl">Screenshots</h2>
        <p class="mt-2 text-sm text-slate-300">Marketing site, committee sign-in, and in-app screens from a demo committee (example.org accounts). No applicant, protocol or production data is shown.</p>
        <div class="mt-5 grid gap-5 sm:grid-cols-2">
          <Shot name="verdict-home" url="verdictethics.com" alt="VERDICT marketing site home page" eager sizes="(min-width:1024px) 380px, 92vw" />
          <Shot name="verdict-product" url="verdictethics.com/product" alt="VERDICT product page with its eight modules" sizes="(min-width:1024px) 380px, 92vw" />
          <Shot name="verdict-security" url="verdictethics.com/security" alt="VERDICT security and data protection page" sizes="(min-width:1024px) 380px, 92vw" />
          <Shot name="verdict-login" url="committee sign-in" alt="A VERDICT committee sign-in page" sizes="(min-width:1024px) 380px, 92vw" />
          <Shot name="verdict-secretariat-submissions" url="demo committee · submissions" alt="VERDICT submissions queue for a demo committee, with status filters and rows for a serious adverse event report, two initial reviews, and a protocol amendment" caption="Submissions queue with status filters." sizes="(min-width:1024px) 380px, 92vw" />
          <Shot name="verdict-site-submission" url="demo committee · package" alt="VERDICT submission package for a demo study, with an empty document upload form and a checklist of six required document types still missing" caption="Submission package and required-document checklist." sizes="(min-width:1024px) 380px, 92vw" />
          <Shot name="verdict-reviewer-submit" url="demo committee · review" alt="VERDICT reviewer form on a demo submission, with the recommendation set to Approve and an empty comments field" caption="Reviewer recommendation form." sizes="(min-width:1024px) 380px, 92vw" />
          <Shot name="verdict-secretariat-decision" url="demo committee · decision" alt="VERDICT record-decision panel on a demo amendment, with the outcome set to approved and empty fields for rationale, conditions, dates, and a decision letter" caption="Panel for recording the committee decision." sizes="(min-width:1024px) 380px, 92vw" />
          <Shot name="verdict-site-letters" url="demo committee · letters" alt="VERDICT approval letters page showing one demo provisional favourable opinion marked ready to download" caption="Approval letter ready to download." sizes="(min-width:1024px) 380px, 92vw" />
          <Shot name="verdict-dashboard-chrome" url="demo committee · dashboard" alt="VERDICT secretariat dashboard for a demo committee, with study and submission counts, an applicants-awaiting-activation notice, and recent submissions" caption="Dashboard with pipeline counts and recent submissions." sizes="(min-width:1024px) 380px, 92vw" />
        </div>
      </div>
    </div>
    <aside class="card h-fit reveal">
      <h2 class="font-semibold text-white">My role</h2><p class="mt-1 text-sm">Product, design and full-stack development</p>
      <h2 class="mt-5 font-semibold text-white">Stack</h2>
      <ul class="mt-2 flex flex-wrap gap-2">{['Next.js','TypeScript','Prisma','PostgreSQL','Railway','Astro','Tailwind'].map(s => <li class="chip">{s}</li>)}</ul>
      <p class="mt-5 text-xs text-slate-300">The source code is private.</p>
    </aside>
  </section>
</Base>
