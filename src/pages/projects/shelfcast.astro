---
import Base from '../../layouts/Base.astro';
import Shot from '../../components/Shot.astro';
import Shapes from '../../components/Shapes.astro';
---
<Base og="og-shelfcast" ogAlt="ShelfCast case study by Collins Milimo" title="ShelfCast case study" description="ShelfCast case study by Collins Milimo: a SaaS that turns ebooks you already own into private, downloadable audiobooks.">
  <section class="hero-bg relative overflow-hidden text-white"><Shapes variant="hero" /><div class="wrap relative py-20">
    <a href="/#projects" class="text-sm text-slate-400 hover:text-white">← All projects</a>
    <p class="eyebrow !text-cy mt-6">Case study · SaaS</p>
    <h1 class="mt-3 text-4xl font-bold sm:text-6xl" transition:name="title-shelfcast"><span class="grad-text">ShelfCast</span></h1>
    <p class="mt-5 max-w-2xl text-lg text-slate-300">Turn books you already own into private, downloadable audiobooks.</p>
    <a href="https://github.com/miliMORE/shelfcast" class="btn-primary mt-8">View on GitHub</a>
  </div></section>
  <section class="wrap py-16 grid gap-10 lg:grid-cols-3">
    <div class="lg:col-span-2 space-y-10">
      <div class="reveal"><h2 class="h2 !text-2xl">The idea</h2><p class="mt-3">Upload an EPUB or a text-layer PDF you own, queue it for text-to-speech, and download MP3 or WAV audio that stays private to your account. No DRM circumvention: only files you have the rights to convert.</p></div>
      <div class="reveal"><h2 class="h2 !text-2xl">How it works</h2>
        <ul class="mt-4 space-y-3 list-disc pl-5">
          <li>Next.js App Router with TypeScript and Tailwind.</li>
          <li>Email-and-password and Google sign-in through Auth.js.</li>
          <li>A database-backed job queue (queued → processing → done or failed) worked by a separate worker process, with no Redis needed.</li>
          <li>Pluggable storage: local disk or S3-compatible.</li>
          <li>Stripe Checkout and Customer Portal for subscriptions, and a health endpoint with a database ping.</li>
          <li>Runs with Docker Compose: web, worker, PostgreSQL and optional MinIO.</li>
        </ul>
      </div>
      <div class="reveal"><h2 class="h2 !text-2xl">Screenshots</h2>
        <p class="mt-2 text-sm text-slate-300">Captured from ShelfCast running locally with no user data.</p>
        <div class="mt-5 grid gap-5 sm:grid-cols-2">
          <div class="sm:col-span-2"><Shot name="shelfcast-home" url="ShelfCast" alt="ShelfCast landing page" eager /></div>
          <Shot name="shelfcast-pricing" url="ShelfCast /pricing" alt="ShelfCast pricing page with Free and Pro plans" sizes="(min-width:1024px) 380px, 92vw" />
          <Shot name="shelfcast-signup" url="ShelfCast /signup" alt="ShelfCast sign-up form" sizes="(min-width:1024px) 380px, 92vw" />
        </div>
        <!-- TODO: library/conversion screenshots need a local Postgres with a fake public-domain book. -->
      </div>
    </div>
    <aside class="card h-fit reveal">
      <h2 class="font-semibold text-white">My role</h2><p class="mt-1 text-sm">Design and full-stack development</p>
      <h2 class="mt-5 font-semibold text-white">Stack</h2>
      <ul class="mt-2 flex flex-wrap gap-2">{['Next.js','TypeScript','Prisma','PostgreSQL','Auth.js','Stripe','Docker'].map(s => <li class="chip">{s}</li>)}</ul>
    </aside>
  </section>
</Base>
